; Project Sottovoce — engine configuration
;
; Engine version is pinned in .godot-version and governed by ADR-0011.
; Autoload inventory is fixed at EIGHT (TDD-01 §2). A ninth requires an ADR;
; test_autoload_inventory.gd fails otherwise.

config_version=5

[application]

config/name="Project Sottovoce"
config/description="Online multiplayer social-stealth game for 4-6 players."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/quit_on_go_back=false

[autoload]

; Order matters: Tuning loads values everything else reads.
; EventBus is signals-only (ADR-0006) and must exist before any subscriber.
Tuning="*res://scripts/autoload/tuning.gd"
EventBus="*res://scripts/presentation/event_bus.gd"
Net="*res://scripts/net/net.gd"
GameState="*res://scripts/autoload/game_state.gd"
Log="*res://scripts/autoload/log.gd"
Strings="*res://scripts/autoload/strings.gd"
Audio="*res://scripts/presentation/audio/audio.gd"
DebugConsole="*res://scripts/debug/debug_console.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"

[input]

; US-0016. THE DEFAULT BINDINGS. GDD-02 §1.2 (keyboard/mouse) and §1.3 (gamepad).
;
; Action names are the INPUT- IDs, lowercased with hyphens as underscores —
; INPUT-ABILITY-1 is input_ability_1. The transform is mechanical in both
; directions (InputActions.action_name), so no lookup table can drift.
; test_input_map_bound.gd asserts this section against InputActions, which is
; asserted against Ids, which is asserted against GDD-02. Adding a row here
; without a row there fails; the reverse fails too.
;
; Every deadzone is 0.05, not Godot's 0.2. The real gate is
; TUN-SPEED-STICK-DEADZONE, applied by InputSampler — one authority, in tuning,
; where it can be changed without touching engine configuration. A large
; deadzone here would silently clamp the tunable's lower range.
;
; INPUT-MENU is the one action with no rebind (GDD-02 §1.4): a player who has
; rebound their way out of the pause menu cannot rebind their way back in.

input_move_left={
"deadzone": 0.05,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65,"pressed":false)
, Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)
]
}
input_move_right={
"deadzone": 0.05,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68,"pressed":false)
, Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)
]
}
input_move_back={
"deadzone": 0.05,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83,"pressed":false)
, Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)
]
}
input_move_forward={
"deadzone": 0.05,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87,"pressed":false)
, Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)
]
}
input_look_left={
"deadzone": 0.05,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":-1.0)
]
}
input_look_right={
"deadzone": 0.05,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":1.0)
]
}
input_look_down={
"deadzone": 0.05,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":1.0)
]
}
input_look_up={
"deadzone": 0.05,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":-1.0)
]
}
input_slow={
"deadzone": 0.05,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194326,"location":1,"pressed":false)
, Object(InputEventJoypadButton,"device":-1,"button_index":7,"pressed":false)
]
}
input_run={
"deadzone": 0.05,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194325,"location":1,"pressed":false)
, Object(InputEventJoypadMotion,"device":-1,"axis":4,"axis_value":1.0)
]
}
input_sprint={
"deadzone": 0.05,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194325,"location":1,"pressed":false)
, Object(InputEventJoypadButton,"device":-1,"button_index":1,"pressed":false)
]
}
input_traverse={
"deadzone": 0.05,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32,"pressed":false)
, Object(InputEventJoypadButton,"device":-1,"button_index":0,"pressed":false)
]
}
input_kill={
"deadzone": 0.05,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":1,"pressed":false)
, Object(InputEventJoypadMotion,"device":-1,"axis":5,"axis_value":1.0)
]
}
input_stun={
"deadzone": 0.05,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":2,"pressed":false)
, Object(InputEventJoypadButton,"device":-1,"button_index":10,"pressed":false)
]
}
input_blend={
"deadzone": 0.05,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69,"pressed":false)
, Object(InputEventJoypadButton,"device":-1,"button_index":2,"pressed":false)
]
}
input_ability_1={
"deadzone": 0.05,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":81,"pressed":false)
, Object(InputEventJoypadButton,"device":-1,"button_index":9,"pressed":false)
]
}
input_ability_2={
"deadzone": 0.05,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":70,"pressed":false)
, Object(InputEventJoypadButton,"device":-1,"button_index":3,"pressed":false)
]
}
input_scan={
"deadzone": 0.05,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":3,"pressed":false)
, Object(InputEventJoypadButton,"device":-1,"button_index":8,"pressed":false)
]
}
input_score={
"deadzone": 0.05,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194306,"pressed":false)
, Object(InputEventJoypadButton,"device":-1,"button_index":4,"pressed":false)
]
}
input_menu={
"deadzone": 0.05,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305,"pressed":false)
, Object(InputEventJoypadButton,"device":-1,"button_index":6,"pressed":false)
]
}

[layer_names]

; TDD-06 §1.2 / SCENE_AND_NODE_CONVENTIONS §6.
; Traversal probes mask WORLD only — a determinism requirement, not an
; optimisation: a probe that could hit an interpolated body would resolve
; differently on client and server.
3d_physics/layer_1="WORLD"
3d_physics/layer_2="PAWN"
3d_physics/layer_3="NPC"
3d_physics/layer_4="TRIGGER"

[navigation]

3d/default_cell_size=0.25
3d/default_edge_connection_margin=0.25

[physics]

; TDD-03 §1: the 30 Hz net tick is every SECOND physics frame.
; Pawn integration substeps at 60 Hz, once per received InputCommand,
; because a server integrating at dt=1/30 diverges from a client
; predicting twice at dt=1/60 on every acceleration curve.
;
; US-0045: everything in the world is moved in _physics_process at 60 Hz and the
; client renders far faster, so without this each position was drawn 2.7 times
; before it changed while the camera -- which runs on _process -- slid between
; them. Measured on a live client: 37.7 % of rendered frames showed a new
; position. That is the judder the owner reported as "jitters when NPCs are in
; the game"; the crowd does not cause it, it makes it legible.
; CameraRig opts OUT, because it writes its own transform every rendered frame.
common/physics_interpolation=true
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
anti_aliasing/quality/msaa_3d=2
