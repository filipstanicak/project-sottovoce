tonemap_mode = 2

; Client topology: mirrors of replicated state, the local pawn, and the HUD.
; Carries no GameSystem — systems exist only server-side (TDD-01 §1.2).
;
; US-0016 added the input chain: InputSampler reads the controls, LocalPawnDriver
; feeds PawnStateMachine.step() at 60 Hz, and the pawn finally moves.
;
; US-0021 replaced DebugFollowCamera with the real SYS-CAMERA rig. The FOV
; ladder is US-0022 and crowd-scan is US-0023, so the rig holds a fixed FOV.
;
; US-0091 added the greybox body and the light to see it by. THERE WAS NEITHER
; UNTIL SOMEBODY LOOKED AT THE GAME: the pawn was an empty PersonaVisuals node,
; and nothing in the project had ever created a light or an environment, so the
; district rendered near-black under Godot's default ambient. A third-person
; camera exists to show you your own silhouette (GDD-02 §4.1) and there was no
; silhouette and no light on it.
;
; THIS IS GREYBOX LIGHTING, NOT THE ART PASS. GDD-05 §9 makes lighting zones step
; 9 of the level-design pipeline and this is not that: one key light and a flat
; sky, chosen so value contrast exists at all. ART_BIBLE §3.1's "value over hue"
; is the rule it has to serve — readability comes from light and dark.
;
; THE RIG LISTENS TO THE DRIVER, NOT THE SAMPLER. InputSampler has no loop of its
; own — the driver calls sample() once a frame and emits what it got. When both
; nodes sampled, input ran at 120 Hz and TUN-SPEED-SPRINT-HOLD opened in half its
; 0.4 s. This is also why node ORDER here decides nothing.

[node name="ClientRoot" type="Node"]

[node name="World" type="Node3D" parent="."]

[node name="WorldEnvironment" type="WorldEnvironment" parent="World"]
environment = SubResource("Env_greybox")

; Roughly mid-afternoon, high enough that streets are lit and low enough that
; façades and roof edges cast a readable shadow. Shadows are on because a
; shadowless greybox has no depth at all and every wall reads as a flat panel.
[node name="Sun" type="DirectionalLight3D" parent="World"]
transform = Transform3D(0.866, -0.404, 0.295, 0, 0.590, 0.807, -0.5, -0.699, 0.511, 0, 30, 0)
light_energy = 1.2
shadow_enabled = true

[node name="Mirrors" type="Node" parent="."]

; The client half of the net loop. InputSender pushes every sampled command
; upstream; RemotePawns places the other players from each snapshot. Neither
; knows the other exists — ClientNet joins them (US-0030).
[node name="ClientNet" type="Node" parent="."]
script = ExtResource("8_clientnet")

[node name="InputSender" type="Node" parent="ClientNet"]
script = ExtResource("6_sender")
driver_path = NodePath("../../LocalPawnDriver")

[node name="RemotePawns" type="Node3D" parent="ClientNet"]
script = ExtResource("7_remotes")

; The crowd. Records have reached the wire since US-0030 and nothing drew one
; until this node existed — the district was empty on every client for a
; milestone. Absence means "no update" here, never "gone": see npc_view.gd.
[node name="NpcView" type="Node3D" parent="ClientNet"]
script = ExtResource("10_npcview")

; US-0033. The simulation snaps and the visual blends — see reconciler.gd.
[node name="Reconciler" type="Node" parent="ClientNet"]
script = ExtResource("9_reconciler")
driver_path = NodePath("../../LocalPawnDriver")

[node name="Hud" type="CanvasLayer" parent="."]
script = ExtResource("11_hud")
camera_path = NodePath("../World/CameraRig")

[node name="Map" parent="World" instance=ExtResource("1_map")]

[node name="PawnLocal" parent="World" instance=ExtResource("2_pawn")]

[node name="InputSampler" type="Node" parent="."]
script = ExtResource("3_sampler")

[node name="LocalPawnDriver" type="Node" parent="."]
script = ExtResource("4_driver")
pawn_path = NodePath("../World/PawnLocal")
sampler_path = NodePath("../InputSampler")

[node name="CameraRig" type="Camera3D" parent="World"]
script = ExtResource("5_camera")
driver_path = NodePath("../../LocalPawnDriver")
