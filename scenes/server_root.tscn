; Server topology. NO PRESENTATION NODES — the release server export excludes
; scripts/presentation/, scripts/mirrors/ and scenes/ui/ entirely, so anything
; visual here would break the headless build rather than merely waste memory.
; test_server_root_has_no_presentation.gd asserts it.

[node name="ServerRoot" type="Node"]
script = ExtResource("4_root")

[node name="MatchDirector" type="Node" parent="."]
script = ExtResource("2_director")

[node name="Systems" type="Node" parent="."]

; SYS-CROWD. Ticks every active brain and the steering under it, at the `crowd`
; stage — registered from server_root.gd, because a system that is merely IN the
; scene is a system nothing ticks. US-0039's first criterion was ticked for a
; pool that was in no scene at all; this is the same mistake's other half.
[node name="CrowdDirector" type="Node" parent="Systems"]
script = ExtResource("9_crowddir")

; SYS-CONTRACT. The Hamiltonian cycle over living players, at the `contract`
; stage — AFTER `combat`, so the cycle is repaired in the same tick a death
; resolves and nobody is contractless at a tick boundary. US-0050.
[node name="ContractSystem" type="Node" parent="Systems"]
script = ExtResource("10_contract")

; SYS-SUSPICION. The scalar every other social system reads, at the `suspicion`
; stage — AFTER `crowd`, because TUN-SUSPICION-GAIN-OPEN asks whether an NPC is
; within 6 m and last tick's answer lets a player be "alone" inside a pocket that
; has already re-formed. US-0052.
[node name="SuspicionSystem" type="Node" parent="Systems"]
script = ExtResource("11_suspicion")

; SYS-DETECTION. Per-observer render state, at the `detection` stage — AFTER
; `suspicion`, because the render state is computed from tier and a tick of lag
; makes the silhouette disagree with the tier indicator. It also holds the only
; line-of-sight query in the project. US-0055, US-0056.
[node name="DetectionSystem" type="Node" parent="Systems"]
script = ExtResource("12_detection")

; SYS-ABILITY. Request, five validations, cooldown, tell broadcast, effect — at
; the `abilities` stage, BEFORE `combat`, so a Cinderfall thrown this tick is
; already blocking kills when the kill stage runs. US-0066.
[node name="AbilitySystem" type="Node" parent="Systems"]
script = ExtResource("14_ability")

; SYS-KILL. Validation against the lag-compensated world, the contest window and
; the committed animation, at the `combat` stage — BEFORE `contract`, so the
; cycle is repaired in the same tick a death resolves. US-0060.
[node name="KillSystem" type="Node" parent="Systems"]
script = ExtResource("13_kill")

